# Gemini API key, used for both embeddings (gemini-embedding-001) and chat
# completions (gemini-flash-latest). Free, no credit card required: get one
# at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Pinecone API key. Get one at https://app.pinecone.io
PINECONE_API_KEY=...

# Name of the Pinecone index to use. The backend will create it automatically
# (1536 dimensions, cosine metric) if it doesn't already exist.
PINECONE_INDEX_NAME=pdf-rag-index

# Comma-separated list of origins allowed to call this API. Include your
# deployed Vercel URL and localhost for local frontend development.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
